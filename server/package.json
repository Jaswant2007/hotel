{
  "name": "hotel-sri-vari-server",
  "version": "1.0.0",
  "description": "Backend API for Hotel Sri Vari online food ordering",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node scripts/seed.js",
    "db": "easydb-server --adapter sqlite --data .data/db --host 0.0.0.0 --port 27017",
    "db:memory": "easydb-server --adapter memory --port 27017"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@rckflr/easydb-server": "^0.4.0",
    "better-sqlite3": "^13.0.3"
  }
}
