# Application Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/harbour_inn_db

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379

# Cryptographic Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=c2e811f58b76df479b124806a86c67ad9314c1cf6b48834927cbdbcf9df09312
JWT_REFRESH_SECRET=7f516a8b75c160da3ec56a42a0b168a2bfdfb27137f8fce05dc364f9bfef9391
OTP_HMAC_SECRET=b8d781fb42848ca5927ad740ee29c69d80d24f0c43666d925d19db2cf99a8052
CSRF_SECRET=a514d2fa7848df740ee29c69d80d24f0c43666d925d19db2cf99a8052c2e811f

# Token Expiry Durations
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30
OTP_EXPIRY_MINUTES=10

# Email Delivery Configuration (Nodemailer / SMTP / Resend / AWS SES)
# For local testing, Mailpit (included in docker-compose) runs on localhost:1025 with UI on :8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Harbour Inn <reservations@harbourinn-hotel.com>"

# Cookie Configuration
COOKIE_SECURE=false # Set to true in production with HTTPS
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=lax
