{
  "info": {
    "_postman_id": "7b58c812-78d1-412f-981c-8b8398129841",
    "name": "Harbour Inn Authentication API",
    "description": "Production-ready Postman collection for Harbour Inn Email-OTP passwordless authentication service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "guest@harbourinn-hotel.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Request OTP (Login)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"purpose\": \"login\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/request",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "request"]
        }
      }
    },
    {
      "name": "2. Request OTP (Sign Up)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"eleanor.vance@example.com\",\n  \"purpose\": \"signup\",\n  \"name\": \"Eleanor Vance\",\n  \"phone\": \"+1 (555) 234-5678\",\n  \"consent\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/request",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "request"]
        }
      }
    },
    {
      "name": "3. Verify OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"code\": \"123456\",\n  \"purpose\": \"login\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/verify",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "verify"]
        }
      }
    },
    {
      "name": "4. Resend OTP",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"purpose\": \"login\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/otp/resend",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "otp", "resend"]
        }
      }
    },
    {
      "name": "5. Refresh Session",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        }
      }
    },
    {
      "name": "6. Get Current Guest Profile (Protected)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/me",
          "host": ["{{baseUrl}}"],
          "path": ["me"]
        }
      }
    },
    {
      "name": "7. List Active Device Sessions",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/me/sessions",
          "host": ["{{baseUrl}}"],
          "path": ["me", "sessions"]
        }
      }
    },
    {
      "name": "8. Log Out Current Device",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        }
      }
    },
    {
      "name": "9. Log Out All Devices",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/auth/logout-all",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout-all"]
        }
      }
    }
  ]
}
